<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DotVector.Cli</AssemblyName>
    <RootNamespace>DotVector.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <Description>Command-line tool for local DotVector embedded databases.</Description>
  </PropertyGroup>

  <!--
    Native AOT 单文件发布配置（M9）。
    用法：dotnet publish src/DotVector.Cli -c Release -r linux-x64
    Debug 配置下不启用 AOT，避免拖慢日常构建。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CLI 仅引用客户端 SDK 项目（src/DotVector.Data，NuGet 包名 DotVector），
      通过 Embedded 工厂打开本地 .dvec/ 数据库目录。
      不引入 DotVector 独立服务端、gRPC 或 Docker 服务端形态。
    -->
    <ProjectReference Include="..\DotVector.Data\DotVector.Data.csproj" />
  </ItemGroup>

</Project>
