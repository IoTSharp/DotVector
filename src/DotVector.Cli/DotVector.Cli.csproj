<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DotVector.Cli</AssemblyName>
    <RootNamespace>DotVector.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <Description>Command-line client for DotVector gRPC servers.</Description>
  </PropertyGroup>

  <!--
    Native AOT 单文件发布配置（M9）。
    用法：dotnet publish src/DotVector.Cli -c Release -r linux-x64
    Debug 配置下不启用 AOT，避免拖慢日常构建。
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>full</TrimMode>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CLI 仅引用客户端 SDK 项目（src/DotVector.Data，NuGet 包名 DotVector），同时支持：
        - 当前命令面：GrpcDotVectorClient → DotVector（gRPC server）
        - 后续本地命令：可经客户端 SDK 的 Embedded 工厂进入 DotVector.Core
      不直接引用 DotVector（服务端壳）与 DotVector.Core（嵌入式引擎）。
    -->
    <ProjectReference Include="..\DotVector.Data\DotVector.Data.csproj" />
  </ItemGroup>

</Project>
