<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DotVector</PackageId>
    <AssemblyName>DotVector.Data</AssemblyName>
    <RootNamespace>DotVector.Data</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>DotVector client SDK and Microsoft.Extensions.VectorData adapter.</Description>
    <!--
      客户端 VectorData 适配层（M7）。
      此项目提供本地嵌入式访问和 VectorData 适配，不包含独立服务端、
      gRPC 或 Docker 服务端形态。
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 仅依赖共享契约层，不依赖服务端实现 -->
    <ProjectReference Include="..\DotVector.Core\DotVector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotVector.Tests" />
  </ItemGroup>

</Project>
