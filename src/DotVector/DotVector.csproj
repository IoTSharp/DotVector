<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DotVector</AssemblyName>
    <RootNamespace>DotVector.Server</RootNamespace>
    <!--
      DotVector 服务端宿主：托管多个嵌入式数据库实例（DotVector.Core）。
      每个目录 = 一个 DotVector.Core 实例；多个数据库 = 多个 Core 实例。
      M9 起将在此实现 gRPC 端点、进程托管、生命周期管理。
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotVector.Core\DotVector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotVector.Tests" />
  </ItemGroup>

</Project>
