<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>DotVector</AssemblyName>
    <RootNamespace>DotVector.Server</RootNamespace>
    <!--
      DotVector 服务端宿主：托管多个嵌入式数据库实例（DotVector.Core）。
      每个目录 = 一个 DotVector.Core 实例；多个数据库 = 多个 Core 实例。
      M9 起在此实现 gRPC 端点、进程托管、生命周期管理。
    -->
    <!--
      Web SDK Exe：作为 gRPC 服务端宿主独立可执行。
      DotVector.Cli 不引用本项目（AGENTS.md 强制约束），由本 exe 直接提供 serve 入口。
    -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Description>DotVector gRPC server host for running embedded DotVector.Core databases behind a remote API.</Description>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <PublishAot>false</PublishAot>
    <!--
      gRPC 服务端宿主依赖 Grpc.AspNetCore；.NET 10 起 ASP.NET Core + Grpc.AspNetCore
      已基本对齐 trim/AOT 分析，先打开 IsAotCompatible 让分析器在 build 阶段暴露问题。
      若部分调用不可避免触发 IL2026/IL3050，会通过显式 [RequiresUnreferencedCode] / annotation
      解决而不是关掉分析。
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotVector.Core\DotVector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\protos\dotvector.proto" GrpcServices="Server" Link="Protos\dotvector.proto" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotVector.Tests" />
  </ItemGroup>

</Project>
